{
    "name": "app-cv-editor",
    "version": "1.0.0",
    "description": "A CV editor that runs entirely in your browser: 12 themes, 4 layouts, 3 languages and a one-page PDF.",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "engines": {
        "node": "^22.13.0 || >=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "playwright test"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "6.5.2",
        "html-to-image": "1.11.11"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.58.2",
        "@types/node": "24.13.3",
        "eslint": "10.15.0",
        "globals": "17.3.0",
        "prettier": "3.8.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.73.0",
        "vite": "7.3.7"
    }
}
